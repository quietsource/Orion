{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "rootDir": "src", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "noUncheckedIndexedAccess": true
  },
  "include": ["src/renderer/**/*.ts", "src/shared/**/*.ts"]
}
